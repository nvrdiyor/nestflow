# Copy to .env on your VPS, then: docker compose up -d --build

# REQUIRED — admin panel password (username defaults to nvrdiyor).
ADMIN_PASSWORD=change-me-to-a-strong-password
#ADMIN_USERNAME=nvrdiyor

# Recommended — long random string (else auto-generated inside the volume).
#JWT_SECRET=

# IP-only mode: app on port 80 (default). For HTTPS mode set ALL THREE:
#HTTP_PORT=127.0.0.1:8787
#DOMAIN=your-domain.com
#TRUST_PROXY=1

#STARTING_CREDITS=100
# Everyone is VIP (free, unlimited nesting) until this is set to false.
#VIP_ALL=true

# Telegram sign-in bot token from @BotFather: enables "Continue with Telegram"
# and Telegram-code confirmation of email sign-ups. Keep it secret.
#TELEGRAM_BOT_TOKEN=
